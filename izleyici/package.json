{
  "name": "galya-izleyici",
  "version": "1.0.0",
  "private": true,
  "description": "VegaWinA5'in veritabanına gönderdiği SQL komutlarını kaydeden taşınabilir araç",
  "author": "Bayraktar Yazılım",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bayraktar.galyaizleyici",
    "productName": "Galya Izleyici",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "Galya-Izleyici.exe"
    }
  }
}
